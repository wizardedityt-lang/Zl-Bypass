-- ========================================================================
-- 1. HARDWARE ENVIRONMENT & RESOLUTION
-- ========================================================================
local camera = workspace.CurrentCamera
local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
local isMobile = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or (vp.X < 850)

local THEME = {
    Width = isMobile and 260 or 320,
    Height = isMobile and 124 or 134,
    BtnHeight = isMobile and 46 or 50,
    Corner = 12,
    DeviceTag = isMobile and "MOBILE" or "DESKTOP",
    TargetURL = "https://raw.githubusercontent.com/xspeedHub0/Zlhub/main/ZLPVPreview.lua"
}

-- ========================================================================
-- 2. SES SENTEZLEYİCİ
-- ========================================================================
local function playTone(kind)
    pcall(function()
        local s = Instance.new("Sound")
        s.Volume = 0.4
        if kind == "click" then
            s.SoundId = "rbxassetid://6895079853"
            s.Pitch = 1.35
        elseif kind == "success" then
            s.SoundId = "rbxassetid://6436709848"
            s.Pitch = 1.2
            s.Volume = 0.6
        end
        s.Parent = SoundService
        s:Play()
        s.Ended:Connect(function() s:Destroy() end)
    end)
end

-- ========================================================================
-- 3. 0MS PRE-CACHE & ÇÖKMEZ DEVRE DIŞI BIRAKICI
-- ========================================================================
local cachedSource = nil
local isExecuting = false
local runCount = 0

local function fetchSource()
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if type(req) == "function" then
        local res = req({
            Url = THEME.TargetURL .. "?nocache=" .. tostring(os.time()),
            Method = "GET"
        })
        if res and res.Body and #res.Body > 0 then
            return res.Body
        end
    end
    return game:HttpGet(THEME.TargetURL .. "?nocache=" .. tostring(os.time()))
end

task.spawn(function()
    local ok, src = pcall(fetchSource)
    if ok and src and #src > 0 then
        cachedSource = src
    end
end)

-- CRASH ÇÖZÜMÜ: :Destroy() çağrılmaz, C++ motor referans hatası engellenir
local function safeDisableOldGui()
    local containers = { playerGui }
    pcall(function()
        if typeof(gethui) == "function" then table.insert(containers, gethui()) end
    end)

    for i = 1, #containers do
        local parent = containers[i]
        if parent then
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name ~= "ZlhubReloadUI" then
                    local nm = child.Name:lower()
                    if nm:find("zl", 1, true) or nm:find("zlpv", 1, true) or nm:find("xspeed", 1, true) then
                        pcall(function()
                            if child:IsA("ScreenGui") or child:IsA("BillboardGui") then
                                child.Enabled = false
                            end
                            if child:IsA("GuiObject") then
                                child.Visible = false
                            end
                        end)
                    end
                end
            end
        end
    end
end

-- ========================================================================
-- 4. TAM EKRAN ROOT GUI
-- ========================================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ZlhubReloadUI"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local function attachScreen()
    local mounted = false
    pcall(function()
        if typeof(gethui) == "function" then
            screenGui.Parent = gethui()
            mounted = true
        elseif syn and syn.protect_gui then
            syn.protect_gui(screenGui)
            screenGui.Parent = CoreGui
            mounted = true
        end
    end)
    if not mounted or not screenGui.Parent then
        screenGui.Parent = playerGui
    end
end
attachScreen()

