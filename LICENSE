-- ========================================================================
-- 9. SÜRÜKLEME FİZİĞİ (TILT DRAG)
-- ========================================================================
local dragging = false
local dragStart = Vector3.zero
local startPos = UDim2.new()
local dragVel = 0
local lastX = 0

dragHeader.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        lastX = input.Position.X

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Rotation = 0 }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        dragVel = input.Position.X - lastX
        lastX = input.Position.X

        local tiltAngle = math.clamp(dragVel * 0.4, -7, 7)
        mainFrame.Rotation = tiltAngle

        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
        halo.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X - 6,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y - 6
        )
    end
end)

-- ========================================================================
-- 10. RUNTIME RENDER DÖNGÜSÜ (HAFİFLETİLMİŞ & STABİL)
-- ========================================================================
local rotSpeed = 90
local frameCount = 0
local lastSync = os.clock()

local heartbeatConn = RunService.RenderStepped:Connect(function(dt)
    if galaxyGradient and galaxyGradient.Parent then
        galaxyGradient.Rotation = (galaxyGradient.Rotation + rotSpeed * dt) % 360
    end

    frameCount = frameCount + 1
    local now = os.clock()
    if now - lastSync >= 0.5 then
        local fpsVal = math.floor(frameCount / (now - lastSync))
        fpsLabel.Text = "FPS: " .. tostring(fpsVal)
        frameCount = 0
        lastSync = now

        pcall(function()
            local pingVal = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
            pingLabel.Text = string.format("MS: %.0f", pingVal)
        end)
    end
end)
table.insert(_G.NebulaSignalRegistry, heartbeatConn)

-- ========================================================================
-- 11. GÜVENLİ TETİKLEME & ZÜMRÜT FLAŞ (ÇÖKME YAPMAZ)
-- ========================================================================
local function TriggerExecution()
    if isExecuting then return end
    isExecuting = true

    playTone("click")

    -- Yumuşak basılma animasyonu
    TweenService:Create(actionButton, TweenInfo.new(0.06), { Size = UDim2.new(0.97, 0, 0.92, 0) }):Play()
    task.delay(0.06, function()
        TweenService:Create(actionButton, TweenInfo.new(0.1), { Size = UDim2.new(1, 0, 1, 0) }):Play()
    end)

    -- Zümrüt Yeşili Flaş
    btnGrad.Color = emeraldGradColors
    btnGlow.BackgroundColor3 = Color3.fromRGB(0, 240, 150)
    btnGlow.BackgroundTransparency = 0.6
    actionButton.Text = "✔ EXECUTED"

    task.spawn(function()
        -- 1. ADIM: Eski script arayüzünü C++ çökmesi olmadan gizle
        safeDisableOldGui()

        -- 2. ADIM: Kodu al
        local code = cachedSource
        if not code then
            local ok, src = pcall(fetchSource)
            if ok and src and #src > 0 then
                code = src
                cachedSource = src
            else
                actionButton.Text = "✖ HTTP FAIL"
                btnGlow.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.4)
                actionButton.Text = "⚡ NEBULA BYPASS"
                btnGrad.Color = originalGradColors
                btnGlow.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
                isExecuting = false
                return
            end
        end

        -- 3. ADIM: Çalıştır
        local compileOk, fn = pcall(loadstring, code)
        if compileOk and type(fn) == "function" then
            task.spawn(fn)
            runCount = runCount + 1
            runsLabel.Text = "RUNS: " .. tostring(runCount)
            playTone("success")
        end

        task.wait(0.35)
        TweenService:Create(btnGlow, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
            BackgroundColor3 = Color3.fromRGB(0, 200, 255),
            BackgroundTransparency = 0.85
        }):Play()

        btnGrad.Color = originalGradColors
        actionButton.Text = "⚡ ZL BYPASS"
        isExecuting = false
    end)
end

actionButton.MouseButton1Click:Connect(TriggerExecution)
actionButton.Activated:Connect(function()
    if not isExecuting then
        TriggerExecution()
    end
end)

-- Hit-Test Fallback (Mobil executor'larda dokunmatik tıklama garantisi)
local hitTestConn = UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not isExecuting and mainFrame.Visible then
            local mouseLoc = Vector2.new(input.Position.X, input.Position.Y)
            local btnAbsPos = actionButton.AbsolutePosition
            local btnAbsSize = actionButton.AbsoluteSize

            if mouseLoc.X >= btnAbsPos.X and mouseLoc.X <= btnAbsPos.X + btnAbsSize.X and
               mouseLoc.Y >= btnAbsPos.Y and mouseLoc.Y <= btnAbsPos.Y + btnAbsSize.Y then
                TriggerExecution()
            end
        end
    end
end)
table.insert(_G.NebulaSignalRegistry, hitTestConn)
