local function createMetricBox(text, xPosScale, widthScale)
    local lbl = Instance.new("TextLabel", statsRow)
    lbl.Size = UDim2.new(widthScale, -4, 1, 0)
    lbl.Position = UDim2.new(xPosScale, 2, 0, 0)
    lbl.BackgroundColor3 = Color3.fromRGB(16, 18, 28)
    lbl.BorderSizePixel = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(150, 160, 190)
    lbl.TextSize = 8
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)

    local s = Instance.new("UIStroke", lbl)
    s.Thickness = 1
    s.Color = Color3.fromRGB(32, 38, 54)
    return lbl
end

